# Per-repo build settings for the iSAQB landing page (public.isaqb.org).
# Rendered via the curriculum-builder image; see curriculum-build.sh.
# `: "${KEY:=value}"` = use this unless already set in the environment.

# AsciiDoc root in docs/ (no .adoc); also the output file name.
# This repo is a landing page, not a curriculum: the real content is
# docs/index.adoc. index-page is a required stub the builder also renders;
# its output (index-page-en.html) is discarded by curriculum-build.sh.
: "${CURRICULUM_FILE:=index-page}"

# Single language, HTML only — landing page is language-neutral.
: "${LANGUAGES:=EN}"

: "${SUFFIX_TAGS:=}"
: "${PREPRESS:=false}"

# Keep images as links instead of embedding them as base64 (appended last so it
# wins over the builder's -a data-uri): the img.shields.io badges stay live, and
# the logo links to images/isaqb-logo.jpg (the deploy workflow copies docs/images
# next to index.html). The release version in the page footer is intentional.
: "${ASCIIDOCTOR_HTML_OPTS:=-a data-uri!}"
